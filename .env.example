# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Clerk (create a development instance; placeholders only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/organization

# Clerk domain used by the local Supabase third-party auth integration.
# Example: example.clerk.accounts.dev (no protocol)
CLERK_DOMAIN=example.clerk.accounts.dev

# Supabase local defaults; replace with each hosted environment's values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_publishable_key

# Server-only. Never prefix with NEXT_PUBLIC_ and never import in browser code.
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key

# Optional Clerk E2E test account. Keep values in local/CI secrets, never Git.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_ORGANIZATION_NAME=
# Internal unresolved fixture ID projected into the E2E Clerk Organization.
E2E_RECOVERY_CASE_ID=

# Phase 1 development fixture webhook only. Generate at least 32 random characters.
DEV_WEBHOOK_SIGNING_SECRET=replace_with_32_or_more_random_characters
